{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git push origin HEAD:main)",
      "Edit(.claude/hooks/*.js)",
      "Write(.claude/hooks/*.js)",
      "Edit(.claude/settings.json)",
      "Bash(npx ts-node scripts/auto-close-topics.ts)",
      "Bash(npx ts-node scripts/resolve-pending-deferrals.ts)",
      "Bash(npx ts-node scripts/load-context-briefs.ts)",
      "Bash(npx ts-node scripts/validate-session-turns.ts *)"
    ]
  },
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/auto-push.js \"session end: auto\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/user-prompt-submit-master-first.js"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/pre-tool-use-task.js"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/pre-tool-use-task-sage-gate.js"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/pre-tool-use-task-master-first.js"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/pre-tool-use-skill-jobs-framing.js"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/post-tool-use-task.js"
          }
        ]
      }
    ]
  }
}
