{
  "$schema": "internal://dispatch-config-v0.1",
  "version": "0.3.0",
  "introducedBy": "D-126/D-127/D-128 (session_142, topic_131, 2026-04-29)",
  "lastUpdatedBy": "D-133 (session_153, topic_131, 2026-05-01) — NCL 전면 폐기로 ncl_emission 필드 제거",
  "comment": "역할 호출 트리거·격리 정책 단일 출처. pre-tool-use-task-sage-gate.js가 sage 격리 read. NCL 전면 폐기(D-133)로 ncl_emission 필드 deprecated.",
  "rules": {
    "jobs": {
      "trigger": {
        "explicit": ["/jobs-framing", "jobs", "잡스", "Jobs framing"],
        "natural_language_suggest_only": [
          "프레이밍",
          "framing",
          "본질",
          "frame",
          "기획",
          "Why",
          "What",
          "Focus",
          "saying no",
          "인지편향"
        ]
      },
      "session_isolation": "shared",
      "first_speaker_override": true,
      "auto_hook": false,
      "ownership": {
        "framing_subject": true,
        "grade_override": true,
        "version_bump": false,
        "orchestration": false,
        "synthesis": false
      },
      "introducedBy": "D-130 (session_145·146, topic_131, 2026-04-30)"
    },
    "sage": {
      "trigger": {
        "explicit": ["/sage", "세이지", "sage 호출"],
        "natural_language_suggest_only": [
          "평가",
          "성장",
          "회고",
          "채점",
          "지표",
          "self-scores"
        ]
      },
      "session_isolation": "exclusive",
      "first_speaker_override": true,
      "auto_hook": false,
      "ace_reject_window_turns": 1,
      "ace_reject_requires_reason": true,
      "ace_reject_reason_min_chars": 50,
      "write_permission": "none",
      "supersedes": ["D-112"]
    },
    "zero": {
      "scope_areas": ["tech-debt", "security-review", "simplify"],
      "session_isolation": "shared",
      "auto_hook": false,
      "internal_tools": ["Cut", "Refine", "Audit"],
      "supersedes": ["D-110"]
    }
  }
}
