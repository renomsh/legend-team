{
  "$schema": "internal://dispatch-config-v0.1",
  "version": "0.3.1",
  "introducedBy": "D-126/D-127/D-128 (session_142, topic_131, 2026-04-29)",
  "lastUpdatedBy": "topic_142 (session_165, 2026-05-02) — rules.edi 신설 (8역할 정책 일관성). D-138 enforcement는 finalize.js 인라인 유지, 본 박제는 정책 단일 출처 비대칭 해소만 — finalize.js 미변경.",
  "comment": "역할 호출 트리거·격리 정책 단일 출처. pre-tool-use-task-sage-gate.js가 sage 격리 read. NCL 전면 폐기(D-133)로 ncl_emission 필드 deprecated. rules.edi는 정책 박제용으로 hook이 read하지 않음(Opt-α, session_165) — D-138 surveillance 영구 박제 회피(Riki R-1).",
  "rules": {
    "jobs": {
      "trigger": {
        "explicit": ["/jobs-framing", "jobs", "잡스", "Jobs framing"],
        "natural_language_suggest_only": [
          "프레이밍",
          "framing",
          "본질",
          "frame",
          "기획",
          "Why",
          "What",
          "Focus",
          "saying no",
          "인지편향"
        ]
      },
      "session_isolation": "shared",
      "first_speaker_override": true,
      "auto_hook": false,
      "ownership": {
        "framing_subject": true,
        "grade_override": true,
        "version_bump": false,
        "orchestration": false,
        "synthesis": false
      },
      "introducedBy": "D-130 (session_145·146, topic_131, 2026-04-30)"
    },
    "sage": {
      "trigger": {
        "explicit": ["/sage", "세이지", "sage 호출"],
        "natural_language_suggest_only": [
          "평가",
          "성장",
          "회고",
          "채점",
          "지표",
          "self-scores"
        ]
      },
      "session_isolation": "exclusive",
      "first_speaker_override": true,
      "auto_hook": false,
      "ace_reject_window_turns": 1,
      "ace_reject_requires_reason": true,
      "ace_reject_reason_min_chars": 50,
      "write_permission": "none",
      "supersedes": ["D-112"]
    },
    "zero": {
      "scope_areas": ["tech-debt", "security-review", "simplify"],
      "session_isolation": "shared",
      "auto_hook": false,
      "internal_tools": ["Cut", "Refine", "Audit"],
      "supersedes": ["D-110"]
    },
    "edi": {
      "trigger": {
        "explicit": ["edi", "에디", "/close"],
        "natural_language_suggest_only": [
          "산출물",
          "compile",
          "박제",
          "정리",
          "report",
          "리포트",
          "마감"
        ]
      },
      "session_isolation": "shared",
      "first_speaker_override": false,
      "auto_hook": true,
      "ownership": {
        "artifact_compile": true,
        "version_bump_confirm": true,
        "anchor_governance": true,
        "framing_subject": false,
        "grade_override": false,
        "orchestration": false,
        "synthesis": false
      },
      "version_bump_override_requires_reason": true,
      "enforcement_note": "D-138 enforcement(enforceEdiAgentSource·auditEdiLlmInvocation·copyEdiReportToSessionContributions)는 .claude/hooks/session-end-finalize.js에 인라인 박제됨. 본 rule은 정책 일관성 박제용으로 hook이 read하지 않음 — Opt-α (session_165, topic_142). config로 enforcement 영구 박제 회피로 D-142 'ROI 0 자동 감시 금지' 정신과 양립. PD-064 P2 (session_194): version_bump_override_requires_reason 필드 추가 — finalize.js#checkVersionBumpConfirmation이 suggested vs confirmed 차이 + overrideReason 부재 시 info gap 박제.",
      "introducedBy": "topic_142 (session_165, 2026-05-02) — 8역할 정책 비대칭 해소"
    }
  }
}
