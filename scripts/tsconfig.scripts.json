{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "outDir": "dist",
    "rootDir": "..",
    "verbatimModuleSyntax": false,
    "noUncheckedSideEffectImports": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noEmitOnError": false
  },
  "include": [
    "./**/*.ts",
    "../src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "_archived",
    "dist",
    "./verify-growth-phase0.ts",
    "./verify-growth-phase1.ts"
  ]
}
